Make pgtk frame cursors use gdk_cursor_new_from_name() instead of the
long-deprecated gdk_cursor_new_for_display()/GdkCursorType enum API.

The enum-based path does not scale-adapt cursor bitmaps for the current
Wayland output scale, which is why the mouse pointer (and I-beam, resize
cursors, etc.) render blurry and mismatched from the configured cursor
theme on HiDPI/fractionally-scaled Wayland outputs. Falls back to the
old enum-based cursor if the active theme doesn't provide the CSS name
(should not happen with any standard cursor theme).

--- a/src/pgtkfns.c
+++ b/src/pgtkfns.c
@@ -600,23 +600,27 @@
   if (FRAME_GTK_WIDGET (f))
     gtk_widget_realize (FRAME_GTK_WIDGET (f));

-#define INSTALL_CURSOR(FIELD, NAME) \
-  FRAME_X_OUTPUT (f)->FIELD = gdk_cursor_new_for_display (FRAME_X_DISPLAY (f), GDK_ ## NAME)
+#define INSTALL_CURSOR(FIELD, NAME, CSS_NAME)                               \
+  FRAME_X_OUTPUT (f)->FIELD                                                 \
+    = gdk_cursor_new_from_name (FRAME_X_DISPLAY (f), CSS_NAME);             \
+  if (!FRAME_X_OUTPUT (f)->FIELD)                                           \
+    FRAME_X_OUTPUT (f)->FIELD                                               \
+      = gdk_cursor_new_for_display (FRAME_X_DISPLAY (f), GDK_ ## NAME)

-  INSTALL_CURSOR (text_cursor, XTERM);
-  INSTALL_CURSOR (nontext_cursor, LEFT_PTR);
-  INSTALL_CURSOR (modeline_cursor, XTERM);
-  INSTALL_CURSOR (hand_cursor, HAND2);
-  INSTALL_CURSOR (hourglass_cursor, WATCH);
-  INSTALL_CURSOR (horizontal_drag_cursor, SB_H_DOUBLE_ARROW);
-  INSTALL_CURSOR (vertical_drag_cursor, SB_V_DOUBLE_ARROW);
-  INSTALL_CURSOR (left_edge_cursor, LEFT_SIDE);
-  INSTALL_CURSOR (right_edge_cursor, RIGHT_SIDE);
-  INSTALL_CURSOR (top_edge_cursor, TOP_SIDE);
-  INSTALL_CURSOR (bottom_edge_cursor, BOTTOM_SIDE);
-  INSTALL_CURSOR (top_left_corner_cursor, TOP_LEFT_CORNER);
-  INSTALL_CURSOR (top_right_corner_cursor, TOP_RIGHT_CORNER);
-  INSTALL_CURSOR (bottom_right_corner_cursor, BOTTOM_RIGHT_CORNER);
-  INSTALL_CURSOR (bottom_left_corner_cursor, BOTTOM_LEFT_CORNER);
+  INSTALL_CURSOR (text_cursor, XTERM, "text");
+  INSTALL_CURSOR (nontext_cursor, LEFT_PTR, "default");
+  INSTALL_CURSOR (modeline_cursor, XTERM, "text");
+  INSTALL_CURSOR (hand_cursor, HAND2, "pointer");
+  INSTALL_CURSOR (hourglass_cursor, WATCH, "wait");
+  INSTALL_CURSOR (horizontal_drag_cursor, SB_H_DOUBLE_ARROW, "ew-resize");
+  INSTALL_CURSOR (vertical_drag_cursor, SB_V_DOUBLE_ARROW, "ns-resize");
+  INSTALL_CURSOR (left_edge_cursor, LEFT_SIDE, "w-resize");
+  INSTALL_CURSOR (right_edge_cursor, RIGHT_SIDE, "e-resize");
+  INSTALL_CURSOR (top_edge_cursor, TOP_SIDE, "n-resize");
+  INSTALL_CURSOR (bottom_edge_cursor, BOTTOM_SIDE, "s-resize");
+  INSTALL_CURSOR (top_left_corner_cursor, TOP_LEFT_CORNER, "nw-resize");
+  INSTALL_CURSOR (top_right_corner_cursor, TOP_RIGHT_CORNER, "ne-resize");
+  INSTALL_CURSOR (bottom_right_corner_cursor, BOTTOM_RIGHT_CORNER, "se-resize");
+  INSTALL_CURSOR (bottom_left_corner_cursor, BOTTOM_LEFT_CORNER, "sw-resize");

 #undef INSTALL_CURSOR
